{
  "id": "sources/pin-and-follow",
  "title": "A pinned source stays on its version; a following one takes the current; only the pin route moves it",
  "covers": [
    "PUT /api/sources/{id}/pin"
  ],
  "fixtures": {
    "files": {
      "in-a/.keep": "",
      "in-b/.keep": "",
      "in-c/.keep": ""
    }
  },
  "steps": [
    {
      "name": "create Lab results",
      "request": {
        "method": "POST",
        "path": "/api/transforms",
        "headers": {
          "Idempotency-Key": "c1"
        },
        "body": {
          "display_name": "Lab results",
          "code": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        raise DataError(f\"value {value!r} is not a number\")\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"v1\"}],\n    }\n",
          "note": "First version",
          "author": "Sam Whitaker"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "{{$tid}}",
          "current_version": 1
        }
      }
    },
    {
      "name": "save version 2",
      "request": {
        "method": "POST",
        "path": "/api/transforms/{{$tid}}/versions",
        "headers": {
          "Idempotency-Key": "v-a"
        },
        "body": {
          "code": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        raise DataError(f\"value {value!r} is not a number\")\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"v2\"}],\n    }\n",
          "base_version": 1
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "version": 2,
          "base_version": 1
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/sources",
        "body": {
          "id": "pinned",
          "name": "Lab pinned",
          "source": {
            "type": "folder",
            "path": "in-a",
            "pattern": "*.csv",
            "poll_seconds": 3600,
            "min_file_age_ms": 0
          },
          "transform": {
            "id": "{{$tid}}",
            "version": 1
          }
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "pin": {
            "transform": {
              "id": "{{$tid}}",
              "display_name": "Lab results"
            },
            "mode": "pinned",
            "version": 1,
            "resolved_version": 1
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/sources",
        "body": {
          "id": "following",
          "name": "Lab following",
          "source": {
            "type": "folder",
            "path": "in-b",
            "pattern": "*.csv",
            "poll_seconds": 3600,
            "min_file_age_ms": 0
          },
          "transform": {
            "id": "{{$tid}}",
            "follow": "current"
          }
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "pin": {
            "mode": "follow_current",
            "version": null,
            "resolved_version": 2
          }
        }
      }
    },
    {
      "name": "save version 3",
      "request": {
        "method": "POST",
        "path": "/api/transforms/{{$tid}}/versions",
        "headers": {
          "Idempotency-Key": "v-b"
        },
        "body": {
          "code": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        raise DataError(f\"value {value!r} is not a number\")\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"v3\"}],\n    }\n",
          "base_version": 2
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "version": 3,
          "base_version": 2
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/sources/pinned"
      },
      "expect": {
        "status": 200,
        "body": {
          "pin": {
            "version": 1,
            "resolved_version": 1
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/sources/following"
      },
      "expect": {
        "status": 200,
        "body": {
          "pin": {
            "resolved_version": 3
          }
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/sources/pinned/pin",
        "body": {
          "version": 3
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "pin": {
            "mode": "pinned",
            "version": 3
          }
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/sources/pinned/pin",
        "body": {
          "follow": "current"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "pin": {
            "mode": "follow_current",
            "resolved_version": 3
          }
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/sources/pinned/pin",
        "body": {
          "version": 9
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "error": "{{string}}",
          "code": "version_not_found"
        }
      }
    },
    {
      "name": "a pin to a transform that does not exist",
      "request": {
        "method": "POST",
        "path": "/api/sources",
        "body": {
          "id": "bad",
          "name": "Lab bad",
          "source": {
            "type": "folder",
            "path": "in-c",
            "pattern": "*.csv",
            "poll_seconds": 3600,
            "min_file_age_ms": 0
          },
          "transform": {
            "id": "nope",
            "version": 1
          }
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "error": "{{string}}",
          "code": "invalid_definition"
        }
      }
    }
  ]
}
