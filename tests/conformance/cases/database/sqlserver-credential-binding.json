{
  "id": "database/sqlserver-credential-binding",
  "title": "On a real SQL Server: the tested revision binds Start, a rotated password does not reach the running source",
  "fixtures": {
    "requires": [
      "mssql"
    ],
    "secrets_key": true,
    "hie": {
      "admission": {
        "synthetic_only": true,
        "databases": [
          {
            "engine": "sqlserver",
            "host": "{{mssql:host}}",
            "port": "{{mssql:port}}",
            "database": "{{mssql:database}}"
          }
        ]
      }
    },
    "files": {
      "transforms/lab_db.py": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        raise DataError(f\"value {value!r} is not a number\")\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"db\"}],\n    }\n"
    }
  },
  "forbid": [
    "{{mssql:password}}",
    "Wrong-Corpus-Pass-1!"
  ],
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/api/secrets",
        "headers": {
          "Idempotency-Key": "s1"
        },
        "body": {
          "name": "labs-reader",
          "value": "{{mssql:password}}"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "{{$sec}}",
          "revision": 1
        }
      }
    },
    {
      "name": "a Test without a revision binds the current one",
      "request": {
        "method": "POST",
        "path": "/api/sources/test",
        "headers": {
          "Idempotency-Key": "t1"
        },
        "body": {
          "source": {
            "type": "database",
            "connection": {
              "engine": "sqlserver",
              "host": "{{mssql:host}}",
              "port": "{{mssql:port}}",
              "database": "{{mssql:database}}",
              "user": "{{mssql:user}}",
              "password": {
                "secret": "{{$sec}}"
              },
              "encrypt": "{{mssql:encrypt}}",
              "trust_cert": "{{mssql:trust_cert}}"
            },
            "read": {
              "mode": "table",
              "table": {
                "schema": "dbo",
                "name": "lab_results"
              },
              "key": [
                "id"
              ],
              "new_rows_by": "id"
            },
            "poll_seconds": 3600
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "evidence": {
            "id": "{{$ev}}",
            "verdict": "passed",
            "credential": {
              "secret": "{{$sec}}",
              "revision": 1
            },
            "checks": [
              "{{contains}}",
              {
                "name": "authenticate",
                "result": "passed"
              }
            ],
            "read": {
              "rows": "{{gte:3}}"
            }
          }
        }
      }
    },
    {
      "name": "the password is rotated to a wrong one",
      "request": {
        "method": "PUT",
        "path": "/api/secrets/{{$sec}}",
        "headers": {
          "Idempotency-Key": "p1"
        },
        "body": {
          "value": "Wrong-Corpus-Pass-1!"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "revision": 2
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/sources",
        "headers": {
          "Idempotency-Key": "st1"
        },
        "body": {
          "id": "labs",
          "name": "Lab results",
          "source": {
            "type": "database",
            "connection": {
              "engine": "sqlserver",
              "host": "{{mssql:host}}",
              "port": "{{mssql:port}}",
              "database": "{{mssql:database}}",
              "user": "{{mssql:user}}",
              "password": {
                "secret": "{{$sec}}",
                "revision": 2
              },
              "encrypt": "{{mssql:encrypt}}",
              "trust_cert": "{{mssql:trust_cert}}"
            },
            "read": {
              "mode": "table",
              "table": {
                "schema": "dbo",
                "name": "lab_results"
              },
              "key": [
                "id"
              ],
              "new_rows_by": "id"
            },
            "poll_seconds": 3600
          },
          "format": "ndjson",
          "transform": "transforms/lab_db.py",
          "evidence": "{{$ev}}"
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "error": "{{string}}",
          "code": "evidence_mismatch",
          "field": "credential"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/sources",
        "headers": {
          "Idempotency-Key": "st2"
        },
        "body": {
          "id": "labs",
          "name": "Lab results",
          "source": {
            "type": "database",
            "connection": {
              "engine": "sqlserver",
              "host": "{{mssql:host}}",
              "port": "{{mssql:port}}",
              "database": "{{mssql:database}}",
              "user": "{{mssql:user}}",
              "password": {
                "secret": "{{$sec}}",
                "revision": 1
              },
              "encrypt": "{{mssql:encrypt}}",
              "trust_cert": "{{mssql:trust_cert}}"
            },
            "read": {
              "mode": "table",
              "table": {
                "schema": "dbo",
                "name": "lab_results"
              },
              "key": [
                "id"
              ],
              "new_rows_by": "id"
            },
            "poll_seconds": 3600
          },
          "format": "ndjson",
          "transform": "transforms/lab_db.py",
          "evidence": "{{$ev}}"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "credential": {
            "secret": "{{$sec}}",
            "revision": 1
          },
          "first_load": {
            "id": "{{$first}}"
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$first}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "status": "done",
          "rows": {
            "read": "{{gte:3}}",
            "failed": 0
          }
        }
      },
      "until_ms": 30000
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/sources/labs/check-now"
      },
      "expect": {
        "status": 202,
        "body": {
          "pass": "{{$p}}"
        }
      }
    },
    {
      "name": "the source still reads with revision 1",
      "request": {
        "method": "GET",
        "path": "/api/sources/labs/passes/{{$p}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "status": "done",
          "error": null
        }
      },
      "until_ms": 30000
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/sources/test",
        "headers": {
          "Idempotency-Key": "t2"
        },
        "body": {
          "source": {
            "type": "database",
            "connection": {
              "engine": "sqlserver",
              "host": "{{mssql:host}}",
              "port": "{{mssql:port}}",
              "database": "{{mssql:database}}",
              "user": "{{mssql:user}}",
              "password": {
                "secret": "{{$sec}}",
                "revision": 2
              },
              "encrypt": "{{mssql:encrypt}}",
              "trust_cert": "{{mssql:trust_cert}}"
            },
            "read": {
              "mode": "table",
              "table": {
                "schema": "dbo",
                "name": "lab_results"
              },
              "key": [
                "id"
              ],
              "new_rows_by": "id"
            },
            "poll_seconds": 3600
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "evidence": {
            "verdict": "failed",
            "credential": {
              "revision": 2
            },
            "checks": [
              "{{contains}}",
              {
                "name": "authenticate",
                "result": "failed"
              }
            ]
          }
        }
      }
    }
  ]
}
