{
  "id": "database/describe",
  "title": "Through passing evidence: the tables, then one table's columns, key and row count",
  "covers": [
    "POST /api/evidence/{id}/describe"
  ],
  "fixtures": {
    "sqlite": {
      "labs": [
        "CREATE TABLE lab_results (id INTEGER NOT NULL PRIMARY KEY, patient TEXT NOT NULL, value TEXT NOT NULL, status TEXT, updated_at TEXT)",
        "INSERT INTO lab_results (id, patient, value) VALUES (1, 'p1', '5.1'), (2, 'p2', '5.2'), (3, 'p3', '5.3'), (4, 'p4', '5.4'), (5, 'p5', '5.5'), (6, 'p6', '5.6'), (7, 'p7', '5.7'), (8, 'p8', '5.8'), (9, 'p9', '5.9'), (10, 'p10', '6.0')"
      ]
    },
    "hie": {
      "admission": {
        "synthetic_only": true,
        "databases": [
          {
            "engine": "sqlite",
            "database": "{{sqlite:labs}}"
          }
        ]
      }
    },
    "files": {
      "transforms/lab_db.py": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        raise DataError(f\"value {value!r} is not a number\")\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"db\"}],\n    }\n"
    }
  },
  "steps": [
    {
      "name": "test the connection",
      "request": {
        "method": "POST",
        "path": "/api/sources/test",
        "headers": {
          "Idempotency-Key": "t1"
        },
        "body": {
          "source": {
            "type": "database",
            "connection": {
              "engine": "sqlite",
              "database": "{{sqlite:labs}}"
            },
            "read": {
              "mode": "table",
              "table": {
                "schema": "main",
                "name": "lab_results"
              },
              "key": [
                "id"
              ],
              "new_rows_by": "id"
            },
            "poll_seconds": 3600
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "evidence": {
            "id": "{{$ev}}",
            "verdict": "passed"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/evidence/{{$ev}}/describe",
        "body": {}
      },
      "expect": {
        "status": 200,
        "body": {
          "tables": [
            "{{contains}}",
            {
              "schema": "main",
              "name": "lab_results"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/evidence/{{$ev}}/describe",
        "body": {
          "table": {
            "schema": "main",
            "name": "lab_results"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "table": {
            "schema": "main",
            "name": "lab_results"
          },
          "columns": [
            "{{contains}}",
            {
              "name": "id",
              "type": "{{string}}",
              "nullable": false
            },
            {
              "name": "value",
              "type": "{{string}}",
              "nullable": false
            },
            {
              "name": "status",
              "nullable": true
            }
          ],
          "primary_key": [
            "id"
          ],
          "new_rows_candidates": [
            "{{contains}}",
            "id"
          ],
          "row_count": 10
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/evidence/{{$ev}}/describe",
        "body": {
          "table": {
            "schema": "main",
            "name": "missing"
          }
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "error": "{{string}}",
          "code": "table_not_found"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/sources/test",
        "headers": {
          "Idempotency-Key": "t2"
        },
        "body": {
          "source": {
            "type": "database",
            "connection": {
              "engine": "sqlite",
              "database": "{{sqlite:labs}}"
            },
            "read": {
              "mode": "table",
              "table": {
                "schema": "main",
                "name": "missing"
              },
              "key": [
                "id"
              ],
              "new_rows_by": "id"
            },
            "poll_seconds": 3600
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "evidence": {
            "id": "{{$bad}}",
            "verdict": "failed"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/evidence/{{$bad}}/describe",
        "body": {}
      },
      "expect": {
        "status": 409,
        "body": {
          "error": "{{string}}",
          "code": "evidence_not_passed"
        }
      }
    }
  ]
}
