{
  "id": "sequences/invalid-resource-retained-not-delivered",
  "title": "A resource the destination's $validate finds invalid is kept as a failed row and never delivered",
  "fixtures": {
    "hie": {
      "validation": "required"
    },
    "destination": {
      "invalid": [
        {
          "resourceType": "Observation",
          "field": "status",
          "equals": "bogus",
          "expression": "Observation.status",
          "message": "Observation.status: 'bogus' is not in the value set"
        }
      ]
    },
    "files": {
      "transforms/lab_csv.py": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        raise DataError(f\"value {value!r} is not a number\")\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"v1\"}],\n    }\n",
      "sources/lab.yaml": "id: lab\nname: Lab lab\nsource:\n  type: folder\n  path: inbox\n  pattern: \"*.csv\"\n  poll_seconds: 3600\n  min_file_age_ms: 0\ntransform: transforms/lab_csv.py\ndelivery:\n  initial_backoff_ms: 300\n  max_backoff_ms: 600\n",
      "inbox/a.csv": "id,value,status\n1,5.4,final\n2,6.1,bogus\n3,7.2,final\n"
    }
  },
  "steps": [
    {
      "name": "check lab now",
      "request": {
        "method": "POST",
        "path": "/api/sources/lab/check-now"
      },
      "expect": {
        "status": 202
      }
    },
    {
      "name": "wait for the load",
      "request": {
        "method": "GET",
        "path": "/api/sources/lab/loads"
      },
      "expect": {
        "status": 200,
        "body": {
          "loads": [
            "{{contains}}",
            {
              "id": "{{$load}}",
              "status": "done",
              "rows": {
                "written": 2,
                "failed": 1
              },
              "waiting": null
            }
          ]
        }
      },
      "until_ms": 15000
    },
    {
      "destination": {
        "resources": {
          "Observation": 2
        },
        "validations": "{{gte:3}}",
        "stored": [
          {
            "id": "obs-1"
          },
          {
            "id": "obs-3"
          }
        ],
        "not_stored": [
          {
            "status": "bogus"
          }
        ]
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "failures": [
            {
              "group": "{{$g}}",
              "kind": "validation",
              "count": 1,
              "reason": "{{contains:bogus}}",
              "content": "kept"
            }
          ]
        }
      }
    },
    {
      "name": "a retry with the same program",
      "request": {
        "method": "POST",
        "path": "/api/loads/{{$load}}/retries",
        "headers": {
          "Idempotency-Key": "r1"
        },
        "body": {
          "group": "{{$g}}",
          "version": null
        }
      },
      "expect": {
        "status": 202,
        "body": {
          "retry": {
            "id": "{{$rt1}}",
            "transform": {
              "version": 1
            }
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}/retries/{{$rt1}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "retry": {
            "status": "done",
            "written": 0,
            "failed": 1
          }
        }
      },
      "until_ms": 15000
    },
    {
      "destination": {
        "resources": {
          "Observation": 2
        },
        "not_stored": [
          {
            "status": "bogus"
          }
        ]
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/transforms/lab_csv/versions",
        "headers": {
          "Idempotency-Key": "fix"
        },
        "body": {
          "code": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        raise DataError(f\"value {value!r} is not a number\")\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"v2\"}],\n    }\n",
          "base_version": 1
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "version": 2
        }
      }
    },
    {
      "set_destination": {
        "validate": "unavailable"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/loads/{{$load}}/retries",
        "headers": {
          "Idempotency-Key": "r2"
        },
        "body": {
          "group": "{{$g}}",
          "version": null
        }
      },
      "expect": {
        "status": 202,
        "body": {
          "retry": {
            "id": "{{$rt2}}",
            "transform": {
              "version": 2
            },
            "previous": "{{$rt1}}"
          }
        }
      }
    },
    {
      "name": "the retry waits on validation",
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}/retries/{{$rt2}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "retry": {
            "waiting": "validation_unavailable",
            "written": 0,
            "failed": 0
          }
        }
      },
      "until_ms": 15000
    },
    {
      "sleep_ms": 1000
    },
    {
      "destination": {
        "resources": {
          "Observation": 2
        },
        "not_stored": [
          {
            "id": "obs-2"
          }
        ]
      }
    },
    {
      "set_destination": {
        "validate": "valid"
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}/retries/{{$rt2}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "retry": {
            "status": "done",
            "written": 1,
            "waiting": null
          }
        }
      },
      "until_ms": 15000
    },
    {
      "destination": {
        "stored": [
          {
            "id": "obs-2",
            "status": "final",
            "note": [
              {
                "text": "v2"
              }
            ]
          }
        ]
      }
    }
  ]
}
