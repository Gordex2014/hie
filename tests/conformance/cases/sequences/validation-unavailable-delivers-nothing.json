{
  "id": "sequences/validation-unavailable-delivers-nothing",
  "title": "While the destination cannot validate nothing is delivered and no row fails; once it can, the rows go",
  "fixtures": {
    "hie": {
      "validation": "required"
    },
    "destination": {
      "validate": "unavailable"
    },
    "files": {
      "transforms/lab_csv.py": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        raise DataError(f\"value {value!r} is not a number\")\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"v1\"}],\n    }\n",
      "sources/lab.yaml": "id: lab\nname: Lab lab\nsource:\n  type: folder\n  path: inbox\n  pattern: \"*.csv\"\n  poll_seconds: 3600\n  min_file_age_ms: 0\ntransform: transforms/lab_csv.py\ndelivery:\n  initial_backoff_ms: 300\n  max_backoff_ms: 600\n",
      "inbox/a.csv": "id,value\n1,5.4\n2,6.1\n3,7.2\n"
    }
  },
  "steps": [
    {
      "name": "check lab now",
      "request": {
        "method": "POST",
        "path": "/api/sources/lab/check-now"
      },
      "expect": {
        "status": 202
      }
    },
    {
      "name": "the load waits on validation",
      "request": {
        "method": "GET",
        "path": "/api/sources/lab/loads"
      },
      "expect": {
        "status": 200,
        "body": {
          "loads": [
            "{{contains}}",
            {
              "name": "a.csv",
              "waiting": "validation_unavailable"
            }
          ]
        }
      },
      "until_ms": 15000
    },
    {
      "sleep_ms": 1000
    },
    {
      "destination": {
        "writes": 0,
        "validations": "{{gte:1}}"
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/sources/lab/loads"
      },
      "expect": {
        "status": 200,
        "body": {
          "loads": [
            {
              "rows": {
                "written": 0,
                "failed": 0
              }
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/records?source=lab"
      },
      "expect": {
        "status": 200,
        "body": {
          "records": [
            "{{each}}",
            {
              "outcome": "in_progress"
            }
          ]
        }
      }
    },
    {
      "set_destination": {
        "validate": "valid"
      }
    },
    {
      "name": "check lab now",
      "request": {
        "method": "POST",
        "path": "/api/sources/lab/check-now"
      },
      "expect": {
        "status": 202
      }
    },
    {
      "destination": {
        "resources": {
          "Observation": 3
        }
      },
      "until_ms": 15000
    },
    {
      "name": "wait for the load",
      "request": {
        "method": "GET",
        "path": "/api/sources/lab/loads"
      },
      "expect": {
        "status": 200,
        "body": {
          "loads": [
            "{{contains}}",
            {
              "name": "a.csv",
              "status": "done",
              "waiting": null,
              "rows": {
                "written": 3,
                "failed": 0
              }
            }
          ]
        }
      },
      "until_ms": 15000
    }
  ]
}
