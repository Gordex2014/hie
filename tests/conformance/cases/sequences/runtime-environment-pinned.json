{
  "id": "sequences/runtime-environment-pinned",
  "title": "A version runs only in the environment it was saved in: another one holds loads and retries and refuses Try",
  "fixtures": {
    "hie": {
      "runtime": {
        "url": "{{runtime}}",
        "token_env": "HIE_CONFORMANCE_NO_TOKEN"
      }
    },
    "runtime": {
      "environment": {
        "Python-Runtime-Environment-Id": "cpython-3.14@2-env-0123456789abcdef0123456789abcdef",
        "Python-Runtime-Environment-Digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "Python-Runtime-Environment-Image-Digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "Python-Runtime-Environment-Binding": "hie-record@1",
        "Python-Runtime-Environment-Profile": "hie-batch@1"
      },
      "try": [
        {
          "status": 200,
          "headers": {
            "Python-Runtime-Environment-Id": "cpython-3.14@2-env-fedcba9876543210fedcba9876543210",
            "Python-Runtime-Environment-Digest": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
            "Python-Runtime-Environment-Image-Digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "Python-Runtime-Environment-Binding": "hie-record@1",
            "Python-Runtime-Environment-Profile": "hie-batch@1"
          },
          "body": {
            "replies": [
              {
                "resources": []
              }
            ]
          }
        }
      ],
      "run": {
        "marker": "rt",
        "diagnostics": {
          "warnings": [],
          "stdout": "zq-run-stdout-marker\n"
        }
      }
    },
    "files": {
      "inbox/a.csv": "id,value\n1,5.4\n2,alto\n"
    }
  },
  "forbid_at_rest": {
    "values": [
      "zq-run-stdout-marker"
    ],
    "under": [
      "data"
    ]
  },
  "steps": [
    {
      "name": "create Lab results",
      "request": {
        "method": "POST",
        "path": "/api/transforms",
        "headers": {
          "Idempotency-Key": "c1"
        },
        "body": {
          "display_name": "Lab results",
          "code": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        raise DataError(f\"value {value!r} is not a number\")\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"v1\"}],\n    }\n",
          "note": "First version",
          "author": "Sam Whitaker"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "{{$tid}}",
          "current_version": 1
        }
      }
    },
    {
      "name": "saved in the runtime's default environment",
      "request": {
        "method": "GET",
        "path": "/api/transforms/{{$tid}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "version": {
            "environment": {
              "executor": "python-runtime",
              "id": "cpython-3.14@2-env-0123456789abcdef0123456789abcdef",
              "digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            }
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/sources",
        "body": {
          "id": "lab",
          "name": "Lab lab",
          "source": {
            "type": "folder",
            "path": "inbox",
            "pattern": "*.csv",
            "poll_seconds": 3600,
            "min_file_age_ms": 0
          },
          "transform": {
            "id": "{{$tid}}",
            "version": 1
          }
        }
      },
      "expect": {
        "status": 201
      }
    },
    {
      "name": "check lab now",
      "request": {
        "method": "POST",
        "path": "/api/sources/lab/check-now"
      },
      "expect": {
        "status": 202
      }
    },
    {
      "name": "wait for the load",
      "request": {
        "method": "GET",
        "path": "/api/sources/lab/loads"
      },
      "expect": {
        "status": 200,
        "body": {
          "loads": [
            "{{contains}}",
            {
              "id": "{{$load}}",
              "name": "a.csv",
              "status": "done",
              "rows": {
                "written": 1,
                "failed": 1
              },
              "environment": {
                "id": "cpython-3.14@2-env-0123456789abcdef0123456789abcdef"
              }
            }
          ]
        }
      },
      "until_ms": 15000
    },
    {
      "destination": {
        "stored": [
          {
            "id": "obs-1",
            "note": [
              {
                "text": "rt"
              }
            ]
          }
        ]
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "failures": [
            {
              "group": "{{$g}}"
            }
          ]
        }
      }
    },
    {
      "set_runtime": {
        "environment": {
          "Python-Runtime-Environment-Id": "cpython-3.14@2-env-fedcba9876543210fedcba9876543210",
          "Python-Runtime-Environment-Digest": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
          "Python-Runtime-Environment-Image-Digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "Python-Runtime-Environment-Binding": "hie-record@1",
          "Python-Runtime-Environment-Profile": "hie-batch@1"
        }
      }
    },
    {
      "write_files": {
        "inbox/b.csv": "id,value\n3,6.1\n"
      }
    },
    {
      "name": "check lab now",
      "request": {
        "method": "POST",
        "path": "/api/sources/lab/check-now"
      },
      "expect": {
        "status": 202
      }
    },
    {
      "name": "another environment holds the load",
      "request": {
        "method": "GET",
        "path": "/api/sources/lab/loads"
      },
      "expect": {
        "status": 200,
        "body": {
          "loads": [
            "{{contains}}",
            {
              "name": "b.csv",
              "waiting": "environment_unavailable",
              "rows": {
                "written": 0,
                "failed": 0
              }
            }
          ]
        }
      },
      "until_ms": 15000
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/loads/{{$load}}/retries",
        "headers": {
          "Idempotency-Key": "r1"
        },
        "body": {
          "group": "{{$g}}",
          "version": null
        }
      },
      "expect": {
        "status": 202,
        "body": {
          "retry": {
            "id": "{{$rt}}"
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}/retries/{{$rt}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "retry": {
            "waiting": "environment_unavailable",
            "written": 0,
            "failed": 0
          }
        }
      },
      "until_ms": 15000
    },
    {
      "destination": {
        "resources": {
          "Observation": 1
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/transforms/{{$tid}}/try",
        "body": {
          "run_id": "e-1",
          "input": {
            "records": [
              {
                "id": 1,
                "value": "5.4"
              }
            ]
          }
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "error": "{{string}}",
          "code": "environment_unavailable"
        }
      }
    },
    {
      "set_runtime": {
        "environment": {
          "Python-Runtime-Environment-Id": "cpython-3.14@2-env-0123456789abcdef0123456789abcdef",
          "Python-Runtime-Environment-Digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "Python-Runtime-Environment-Image-Digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "Python-Runtime-Environment-Binding": "hie-record@1",
          "Python-Runtime-Environment-Profile": "hie-batch@1"
        }
      }
    },
    {
      "name": "check lab now",
      "request": {
        "method": "POST",
        "path": "/api/sources/lab/check-now"
      },
      "expect": {
        "status": 202
      }
    },
    {
      "name": "wait for the load",
      "request": {
        "method": "GET",
        "path": "/api/sources/lab/loads"
      },
      "expect": {
        "status": 200,
        "body": {
          "loads": [
            "{{contains}}",
            {
              "name": "b.csv",
              "status": "done",
              "waiting": null,
              "rows": {
                "written": 1
              }
            }
          ]
        }
      },
      "until_ms": 15000
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}/retries/{{$rt}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "retry": {
            "status": "done",
            "waiting": null,
            "failed": 1
          }
        }
      },
      "until_ms": 15000
    }
  ]
}
