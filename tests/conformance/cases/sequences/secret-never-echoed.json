{
  "id": "sequences/secret-never-echoed",
  "title": "A password is never echoed: not on create, read, a malformed body, a failed connection, a refused Start, nor on disk",
  "fixtures": {
    "secrets_key": true,
    "tcp": [
      "allowed"
    ],
    "hie": {
      "admission": {
        "synthetic_only": true,
        "databases": [
          {
            "engine": "sqlserver",
            "host": "127.0.0.1",
            "port": "{{port:allowed}}",
            "database": "labs"
          }
        ]
      }
    },
    "files": {
      "transforms/lab_db.py": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        raise DataError(f\"value {value!r} is not a number\")\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"db\"}],\n    }\n"
    }
  },
  "forbid": [
    "Corpus-Secret-Value-1!",
    "Corpus-Secret-Value-2!"
  ],
  "steps": [
    {
      "name": "keep the password",
      "request": {
        "method": "POST",
        "path": "/api/secrets",
        "headers": {
          "Idempotency-Key": "s1"
        },
        "body": {
          "name": "labs-reader",
          "value": "Corpus-Secret-Value-1!"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "{{$sec}}",
          "revision": 1
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/secrets/{{$sec}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "value": "{{absent}}"
        }
      }
    },
    {
      "name": "a malformed body is not echoed",
      "request": {
        "method": "POST",
        "path": "/api/secrets",
        "headers": {
          "Idempotency-Key": "s2"
        },
        "raw_body": "{\"name\": \"x\", \"value\": \"Corpus-Secret-Value-1!\""
      },
      "expect": {
        "status": 400,
        "body": {
          "error": "{{string}}",
          "code": "invalid_body"
        }
      }
    },
    {
      "name": "a body without a name",
      "request": {
        "method": "POST",
        "path": "/api/secrets",
        "headers": {
          "Idempotency-Key": "s3"
        },
        "body": {
          "value": "Corpus-Secret-Value-1!"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "error": "{{string}}",
          "code": "invalid_body"
        }
      }
    },
    {
      "name": "the connection fails at a server that hangs up",
      "request": {
        "method": "POST",
        "path": "/api/sources/test",
        "headers": {
          "Idempotency-Key": "t1"
        },
        "body": {
          "source": {
            "type": "database",
            "connection": {
              "engine": "sqlserver",
              "host": "127.0.0.1",
              "port": "{{port:allowed}}",
              "database": "labs",
              "user": "hie_reader",
              "password": {
                "secret": "{{$sec}}",
                "revision": 1
              },
              "encrypt": false,
              "trust_cert": true
            },
            "read": {
              "mode": "table",
              "table": {
                "schema": "dbo",
                "name": "lab_results"
              },
              "key": [
                "id"
              ],
              "new_rows_by": "id"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "evidence": {
            "id": "{{$ev}}",
            "verdict": "failed",
            "credential": {
              "secret": "{{$sec}}",
              "revision": 1
            },
            "checks": [
              "{{contains}}",
              {
                "name": "admission",
                "result": "passed"
              },
              {
                "name": "connect",
                "result": "failed",
                "message": "{{string}}"
              }
            ]
          }
        }
      }
    },
    {
      "tcp": {
        "allowed": "{{gte:1}}"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/sources",
        "headers": {
          "Idempotency-Key": "st1"
        },
        "body": {
          "id": "labs",
          "name": "Labs",
          "source": {
            "type": "database",
            "connection": {
              "engine": "sqlserver",
              "host": "127.0.0.1",
              "port": "{{port:allowed}}",
              "database": "labs",
              "user": "hie_reader",
              "password": {
                "secret": "{{$sec}}",
                "revision": 1
              },
              "encrypt": false,
              "trust_cert": true
            },
            "read": {
              "mode": "table",
              "table": {
                "schema": "dbo",
                "name": "lab_results"
              },
              "key": [
                "id"
              ],
              "new_rows_by": "id"
            }
          },
          "format": "ndjson",
          "transform": "transforms/lab_db.py"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "error": "{{string}}",
          "code": "evidence_required"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/sources",
        "headers": {
          "Idempotency-Key": "st2"
        },
        "body": {
          "id": "labs",
          "name": "Labs",
          "source": {
            "type": "database",
            "connection": {
              "engine": "sqlserver",
              "host": "127.0.0.1",
              "port": "{{port:allowed}}",
              "database": "labs",
              "user": "hie_reader",
              "password": {
                "secret": "{{$sec}}",
                "revision": 1
              },
              "encrypt": false,
              "trust_cert": true
            },
            "read": {
              "mode": "table",
              "table": {
                "schema": "dbo",
                "name": "lab_results"
              },
              "key": [
                "id"
              ],
              "new_rows_by": "id"
            }
          },
          "format": "ndjson",
          "transform": "transforms/lab_db.py",
          "evidence": "{{$ev}}"
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "error": "{{string}}",
          "code": "evidence_not_passed"
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/secrets/{{$sec}}",
        "headers": {
          "Idempotency-Key": "p1"
        },
        "body": {
          "value": "Corpus-Secret-Value-2!"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "revision": 2
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/evidence/{{$ev}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "{{$ev}}",
          "credential": {
            "revision": 1
          }
        }
      }
    },
    {
      "name": "the tested revision stays while evidence refers to it",
      "request": {
        "method": "GET",
        "path": "/api/secrets/{{$sec}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "revisions": [
            "{{contains}}",
            {
              "revision": 1,
              "used_by": {
                "evidence": [
                  "{{$ev}}"
                ]
              }
            }
          ]
        }
      }
    }
  ]
}
