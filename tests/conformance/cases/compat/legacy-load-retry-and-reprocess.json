{
  "id": "compat/legacy-load-retry-and-reprocess",
  "title": "A load's failures grouped with samples, the 0.1 retry by reason, and a reprocess with a corrected row",
  "fixtures": {
    "files": {
      "transforms/lab_csv.py": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        raise DataError(f\"value {value!r} is not a number\")\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"v1\"}],\n    }\n",
      "sources/lab.yaml": "id: lab\nname: Lab lab\nsource:\n  type: folder\n  path: inbox\n  pattern: \"*.csv\"\n  poll_seconds: 3600\n  min_file_age_ms: 0\ntransform: transforms/lab_csv.py\n",
      "inbox/a.csv": "id,value\n1,5.4\n2,alto\n3,6.1\n4,xyz\n"
    }
  },
  "steps": [
    {
      "name": "check lab now",
      "request": {
        "method": "POST",
        "path": "/api/sources/lab/check-now"
      },
      "expect": {
        "status": 202
      }
    },
    {
      "name": "the load settles",
      "request": {
        "method": "GET",
        "path": "/api/sources/lab/loads"
      },
      "expect": {
        "status": 200,
        "body": {
          "loads": [
            {
              "id": "{{$load}}",
              "name": "a.csv",
              "status": "done",
              "method": "rest",
              "records": 4,
              "sent": 2,
              "rejected": 2
            }
          ],
          "files": [
            {
              "name": "a.csv"
            }
          ]
        }
      },
      "until_ms": 15000
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "failures": [
            "{{contains}}",
            {
              "kind": "data",
              "reason": "{{contains:'alto'}}",
              "count": 1,
              "first_line": "{{int}}",
              "samples": [
                {
                  "raw": {
                    "value": "alto"
                  }
                }
              ]
            },
            {
              "kind": "data",
              "reason": "{{contains:'xyz'}}",
              "count": 1
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/records?source=lab&status=rejected"
      },
      "expect": {
        "status": 200,
        "body": {
          "records": [
            "{{contains}}",
            {
              "id": "{{$rec}}",
              "error": "{{contains:'xyz'}}"
            }
          ]
        }
      }
    },
    {
      "name": "retry one reason",
      "request": {
        "method": "POST",
        "path": "/api/loads/{{$load}}/retry",
        "body": {
          "reason": "value 'alto' is not a number"
        }
      },
      "expect": {
        "status": 202,
        "body": {
          "load": "{{$load}}",
          "retried": 1
        }
      }
    },
    {
      "name": "reprocess another row with a correction",
      "request": {
        "method": "POST",
        "path": "/api/records/{{$rec}}/reprocess",
        "body": {
          "raw": {
            "id": "4",
            "value": "6.0"
          }
        }
      },
      "expect": {
        "status": 202,
        "body": {
          "id": "{{$rec}}",
          "status": "received",
          "corrected": true
        }
      }
    },
    {
      "name": "check lab now",
      "request": {
        "method": "POST",
        "path": "/api/sources/lab/check-now"
      },
      "expect": {
        "status": 202
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/records/{{$rec}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "status": "sent"
        }
      },
      "until_ms": 15000
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/999999"
      },
      "expect": {
        "status": 404,
        "body": {
          "error": "{{string}}"
        }
      }
    },
    {
      "name": "the 0.1 alias of loads",
      "request": {
        "method": "GET",
        "path": "/api/sources/lab/files"
      },
      "expect": {
        "status": 200,
        "body": {
          "files": [
            {
              "id": "{{$load}}",
              "name": "a.csv"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/metrics"
      },
      "expect": {
        "status": 200,
        "headers": {
          "content-type": "{{contains:text/plain}}"
        },
        "body": "{{contains:hie_records{source=\"lab\",status=\"sent\"}}}"
      }
    }
  ]
}
