{
  "id": "delivery/transaction-uncertain-not-split",
  "title": "A transaction without a confirming answer is outcome unknown, not split nor failed, and is sent again until it settles",
  "fixtures": {
    "destination": {
      "writes": "unavailable",
      "seed": [
        {
          "resourceType": "Patient",
          "id": "pt-1",
          "identifier": [
            {
              "system": "urn:mrn",
              "value": "123"
            }
          ]
        }
      ]
    },
    "files": {
      "transforms/cond.py": "def transform(record, context):\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"subject\": {\"reference\": f\"Patient?identifier=urn:mrn|{record['mrn']}\"},\n        \"valueQuantity\": {\"value\": float(record[\"value\"])},\n    }\n",
      "sources/lab.yaml": "id: lab\nname: Lab lab\nsource:\n  type: folder\n  path: inbox\n  pattern: \"*.csv\"\n  poll_seconds: 3600\n  min_file_age_ms: 0\ntransform: transforms/cond.py\ndelivery:\n  initial_backoff_ms: 300\n  max_backoff_ms: 600\n",
      "inbox/a.csv": "id,mrn,value\n1,123,5.4\n2,123,6.1\n"
    }
  },
  "steps": [
    {
      "name": "check lab now",
      "request": {
        "method": "POST",
        "path": "/api/sources/lab/check-now"
      },
      "expect": {
        "status": 202
      }
    },
    {
      "name": "writes unconfirmed",
      "request": {
        "method": "GET",
        "path": "/api/sources/lab/loads"
      },
      "expect": {
        "status": 200,
        "body": {
          "loads": [
            "{{contains}}",
            {
              "name": "a.csv",
              "waiting": "destination_unavailable",
              "rows": {
                "outcome_unknown": 2,
                "failed": 0,
                "written": 0
              }
            }
          ]
        }
      },
      "until_ms": 15000
    },
    {
      "destination": {
        "writes": 0,
        "bundle_types": [
          "{{each}}",
          "transaction"
        ],
        "resources": {
          "Observation": 0
        }
      }
    },
    {
      "name": "the destination commits and the answer is lost",
      "set_destination": {
        "writes": "commit_then_fail"
      }
    },
    {
      "destination": {
        "resources": {
          "Observation": 2
        }
      },
      "until_ms": 15000
    },
    {
      "name": "a commit without an answer is still unknown",
      "request": {
        "method": "GET",
        "path": "/api/sources/lab/loads"
      },
      "expect": {
        "status": 200,
        "body": {
          "loads": [
            {
              "rows": {
                "outcome_unknown": 2,
                "written": 0,
                "failed": 0
              }
            }
          ]
        }
      }
    },
    {
      "set_destination": {
        "writes": "ok"
      }
    },
    {
      "name": "settled",
      "request": {
        "method": "GET",
        "path": "/api/sources/lab/loads"
      },
      "expect": {
        "status": 200,
        "body": {
          "loads": [
            "{{contains}}",
            {
              "name": "a.csv",
              "status": "done",
              "waiting": null,
              "rows": {
                "outcome_unknown": 0,
                "failed": 0,
                "written": 2
              }
            }
          ]
        }
      },
      "until_ms": 15000
    },
    {
      "name": "every transaction kept both rows: never split",
      "destination": {
        "bundles": [
          "{{each}}",
          [
            "{{string}}",
            "{{string}}"
          ]
        ],
        "resources": {
          "Observation": 2
        }
      }
    },
    {
      "destination": {
        "bundle_types": [
          "{{each}}",
          "transaction"
        ],
        "stored": [
          {
            "id": "obs-1",
            "subject": {
              "reference": "Patient/pt-1"
            }
          },
          {
            "id": "obs-2",
            "subject": {
              "reference": "Patient/pt-1"
            }
          }
        ]
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/sources/lab/loads"
      },
      "expect": {
        "status": 200,
        "body": {
          "loads": [
            {
              "id": "{{$load}}"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "failures": []
        }
      }
    }
  ]
}
