{
  "id": "secrets/delete",
  "title": "A secret no source uses is deleted with every revision",
  "fixtures": {
    "secrets_key": true
  },
  "forbid": [
    "Corpus-Secret-Value-1!"
  ],
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/api/secrets",
        "headers": {
          "Idempotency-Key": "s1"
        },
        "body": {
          "name": "old",
          "value": "Corpus-Secret-Value-1!"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "{{$sec}}"
        }
      }
    },
    {
      "request": {
        "method": "DELETE",
        "path": "/api/secrets/{{$sec}}"
      },
      "expect": {
        "status": 204
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/secrets/{{$sec}}"
      },
      "expect": {
        "status": 404,
        "body": {
          "error": "{{string}}",
          "code": "secret_not_found"
        }
      }
    },
    {
      "request": {
        "method": "DELETE",
        "path": "/api/secrets/{{$sec}}"
      },
      "expect": {
        "status": 404,
        "body": {
          "error": "{{string}}",
          "code": "secret_not_found"
        }
      }
    }
  ]
}
