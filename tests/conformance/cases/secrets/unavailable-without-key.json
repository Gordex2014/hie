{
  "id": "secrets/unavailable-without-key",
  "title": "Without custody configured, secret routes answer 503 and nothing is kept",
  "forbid": [
    "Corpus-Secret-Value-1!"
  ],
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/api/secrets",
        "headers": {
          "Idempotency-Key": "s1"
        },
        "body": {
          "name": "labs-reader",
          "value": "Corpus-Secret-Value-1!"
        }
      },
      "expect": {
        "status": 503,
        "body": {
          "error": "{{string}}",
          "code": "secrets_unavailable"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/secrets"
      },
      "expect": {
        "status": 503,
        "body": {
          "error": "{{string}}",
          "code": "secrets_unavailable"
        }
      }
    }
  ]
}
