{
  "id": "secrets/write-only-revisions",
  "title": "A secret is created, replayed, revised and listed, and its value never comes back",
  "covers": [
    "POST /api/secrets",
    "GET /api/secrets",
    "GET /api/secrets/{id}",
    "PUT /api/secrets/{id}"
  ],
  "fixtures": {
    "secrets_key": true
  },
  "forbid": [
    "Corpus-Secret-Value-1!",
    "Corpus-Secret-Value-2!"
  ],
  "steps": [
    {
      "name": "a key is required",
      "request": {
        "method": "POST",
        "path": "/api/secrets",
        "body": {
          "name": "labs-reader",
          "value": "Corpus-Secret-Value-1!"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "error": "{{string}}",
          "code": "idempotency_key_required"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/secrets",
        "headers": {
          "Idempotency-Key": "s1"
        },
        "body": {
          "name": "labs-reader",
          "value": "Corpus-Secret-Value-1!"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "{{$sec}}",
          "name": "labs-reader",
          "revision": 1,
          "created_at": "{{time}}",
          "value": "{{absent}}",
          "revisions": [
            {
              "revision": 1,
              "created_at": "{{time}}",
              "used_by": {
                "evidence": [],
                "sources": []
              }
            }
          ]
        }
      }
    },
    {
      "name": "the same key replays",
      "request": {
        "method": "POST",
        "path": "/api/secrets",
        "headers": {
          "Idempotency-Key": "s1"
        },
        "body": {
          "name": "labs-reader",
          "value": "Corpus-Secret-Value-1!"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "{{$sec}}",
          "revision": 1
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/secrets",
        "headers": {
          "Idempotency-Key": "s1"
        },
        "body": {
          "name": "labs-reader",
          "value": "Corpus-Secret-Value-2!"
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "error": "{{string}}",
          "code": "idempotency_conflict"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/secrets",
        "headers": {
          "Idempotency-Key": "s2"
        },
        "body": {
          "name": "labs-reader",
          "value": "Corpus-Secret-Value-2!"
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "error": "{{string}}",
          "code": "name_in_use"
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/secrets/{{$sec}}",
        "headers": {
          "Idempotency-Key": "p1"
        },
        "body": {
          "value": "Corpus-Secret-Value-2!"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "{{$sec}}",
          "revision": 2,
          "value": "{{absent}}"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/secrets/{{$sec}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "{{$sec}}",
          "name": "labs-reader",
          "revision": 2,
          "value": "{{absent}}",
          "revisions": [
            "{{contains}}",
            {
              "revision": 2
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/secrets"
      },
      "expect": {
        "status": 200,
        "body": {
          "secrets": [
            {
              "id": "{{$sec}}",
              "revision": 2,
              "value": "{{absent}}"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/secrets/sec_nope"
      },
      "expect": {
        "status": 404,
        "body": {
          "error": "{{string}}",
          "code": "secret_not_found"
        }
      }
    }
  ]
}
