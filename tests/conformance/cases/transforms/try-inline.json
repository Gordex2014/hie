{
  "id": "transforms/try-inline",
  "title": "Try on inline code: per-item dispositions, validation, coverage, nothing written",
  "covers": [
    "POST /api/transforms/try"
  ],
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/api/transforms/try",
        "body": {
          "run_id": "try-1",
          "code": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        raise DataError(f\"value {value!r} is not a number\")\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"inline\"}],\n    }\n",
          "input": {
            "records": [
              {
                "id": 1,
                "value": "5.4"
              },
              {
                "id": 2,
                "value": "alto"
              }
            ]
          }
        }
      },
      "expect": {
        "status": 200,
        "headers": {
          "cache-control": "{{contains:no-store}}"
        },
        "body": {
