{
  "id": "transforms/try-stored-expired",
  "title": "Named rows whose content is gone are refused 410 with each row's content state; passing rows whose content is gone are passed over",
  "fixtures": {
    "hie": {
      "runtime": {
        "url": "{{runtime}}",
        "token_env": "HIE_CONFORMANCE_NO_TOKEN"
      }
    },
    "runtime": {
      "try": [
        {
          "run": true
        }
      ],
      "run": {
        "marker": "rt"
      }
    },
    "files": {
      "inbox/a.csv": "id,value,patient\n1,alto,zq-expired-1\n2,alto,zq-expired-2\n3,5.4,zq-expired-3\n4,6.1,zq-expired-4\n"
    }
  },
  "forbid_at_rest": {
    "values": [
      "zq-expired-1",
      "zq-expired-2",
      "zq-expired-3",
      "zq-expired-4",
      "zq-corrected-2"
    ],
    "under": [
      "data"
    ]
  },
  "steps": [
    {
      "name": "create Lab results",
      "request": {
        "method": "POST",
        "path": "/api/transforms",
        "headers": {
          "Idempotency-Key": "c1"
        },
        "body": {
          "display_name": "Lab results",
          "code": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        raise DataError(f\"value {value!r} is not a number\")\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"v1\"}],\n    }\n"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "{{$tid}}",
          "current_version": 1
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/sources",
        "body": {
          "id": "lab",
          "name": "Lab lab",
          "source": {
            "type": "folder",
            "path": "inbox",
            "pattern": "*.csv",
            "poll_seconds": 3600,
            "min_file_age_ms": 0
          },
          "transform": {
            "id": "{{$tid}}",
            "version": 1
          }
        }
      },
      "expect": {
        "status": 201
      }
    },
    {
      "name": "check lab now",
      "request": {
        "method": "POST",
        "path": "/api/sources/lab/check-now"
      },
      "expect": {
        "status": 202
      }
    },
    {
      "name": "wait for the load",
      "request": {
        "method": "GET",
        "path": "/api/sources/lab/loads"
      },
      "expect": {
        "status": 200,
        "body": {
          "loads": [
            "{{contains}}",
            {
              "id": "{{$load}}",
              "status": "done",
              "rows": {
                "written": 2,
                "failed": 2
              }
            }
          ]
        }
      },
      "until_ms": 15000
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "failures": [
            {
              "group": "{{$g}}",
              "count": 2
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}/failures/{{$g}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "records": [
            {
              "id": "{{$r1}}"
            },
            {
              "id": "{{$r2}}"
            }
          ]
        }
      }
    },
    {
      "name": "a correction writes one failed row",
      "request": {
        "method": "POST",
        "path": "/api/records/{{$r2}}/reprocess",
        "body": {
          "raw": {
            "id": "2",
            "value": "7.5",
            "patient": "zq-corrected-2"
          }
        }
      },
      "expect": {
        "status": 202,
        "body": {
          "id": "{{$r2}}",
          "corrected": true
        }
      }
    },
    {
      "name": "check lab now",
      "request": {
        "method": "POST",
        "path": "/api/sources/lab/check-now"
      },
      "expect": {
        "status": 202
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/records/{{$r2}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "outcome": "written",
          "attempt": 2,
          "content": "purged"
        }
      },
      "until_ms": 15000
    },
    {
      "name": "the other failed row's content expires",
      "request": {
        "method": "POST",
        "path": "/api/failed-content/purge",
        "body": {
          "before": "2100-01-01T00:00:00Z"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "purged": 1
        }
      }
    },
    {
      "name": "named rows without content are refused",
      "request": {
        "method": "POST",
        "path": "/api/transforms/try",
        "body": {
          "run_id": "gone-1",
          "code": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        raise DataError(f\"value {value!r} is not a number\")\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"v1\"}],\n    }\n",
          "input": {
            "stored": {
              "load": "{{$load}}",
              "records": [
                "{{$r1}}",
                "{{$r2}}"
              ],
              "passing": 2
            }
          }
        }
      },
      "expect": {
        "status": 410,
        "body": {
          "error": "{{string}}",
          "code": "content_expired",
          "records": [
            {
              "{{exact}}": true,
              "id": "{{$r1}}",
              "content": "expired"
            },
            {
              "{{exact}}": true,
              "id": "{{$r2}}",
              "content": "purged"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/transforms/{{$tid}}/try",
        "body": {
          "run_id": "gone-2",
          "input": {
            "stored": {
              "load": "{{$load}}",
              "records": [
                {
                  "id": "{{$r1}}",
                  "attempt": 1
                }
              ]
            }
          }
        }
      },
      "expect": {
        "status": 410,
        "body": {
          "error": "{{string}}",
          "code": "content_expired",
          "records": [
            {
              "id": "{{$r1}}",
              "content": "expired"
            }
          ]
        }
      }
    },
    {
      "runtime": {
        "calls": {
          "try": "{{absent}}"
        }
      }
    },
    {
      "name": "passing rows still run; the written row without content is passed over",
      "request": {
        "method": "POST",
        "path": "/api/transforms/try",
        "body": {
          "run_id": "gone-3",
          "code": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        raise DataError(f\"value {value!r} is not a number\")\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"v1\"}],\n    }\n",
          "input": {
            "stored": {
              "load": "{{$load}}",
              "passing": 5
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "headers": {
          "cache-control": "{{contains:no-store}}"
        },
        "body": {
          "run": {
            "outcome": "completed"
          },
          "items": [
            {
              "index": 0,
              "disposition": "reported",
              "result": {
                "resources": [
                  {
                    "resourceType": "Observation",
                    "id": "obs-3",
                    "valueQuantity": {
                      "value": 5.4
                    }
                  }
                ]
              },
              "input": {
                "record": "{{int}}",
                "load": "{{$load}}",
                "line": 4,
                "outcome": "written",
                "attempt": 1,
                "transform": {
                  "id": "{{$tid}}",
                  "version": 1
                }
              }
            },
            {
              "index": 1,
              "disposition": "reported",
              "result": {
                "resources": [
                  {
                    "resourceType": "Observation",
                    "id": "obs-4",
                    "valueQuantity": {
                      "value": 6.1
                    }
                  }
                ]
              },
              "input": {
                "record": "{{int}}",
                "load": "{{$load}}",
                "line": 5,
                "outcome": "written",
                "attempt": 1,
                "transform": {
                  "id": "{{$tid}}",
                  "version": 1
                }
              }
            }
          ],
          "coverage": {
            "requested": 2,
            "reported": 2,
            "complete": true
          },
          "results": [
            {
              "record": {
                "{{exact}}": true,
                "id": "3",
                "value": "5.4",
                "patient": "zq-expired-3"
              }
            },
            {
              "record": {
                "{{exact}}": true,
                "id": "4",
                "value": "6.1",
                "patient": "zq-expired-4"
              }
            }
          ]
        }
      }
    },
    {
      "runtime": {
        "calls": {
          "try": 1
        }
      }
    }
  ]
}
