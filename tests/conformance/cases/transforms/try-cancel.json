{
  "id": "transforms/try-cancel",
  "title": "A running Try is cancelled: its answer reads stopped; a finished one cannot be cancelled",
  "covers": [
    "POST /api/transforms/try-runs/{run}/cancel",
    "GET /api/transforms/try-runs/{run}"
  ],
  "fixtures": {
    "hie": {
      "runtime": {
        "url": "{{runtime}}",
        "token_env": "HIE_CONFORMANCE_NO_TOKEN"
      }
    },
    "runtime": {
      "try": [
        {
          "delay_ms": 5000,
          "status": 200,
          "headers": {
            "Python-Runtime-Environment-Id": "cpython-3.14@2-env-0123456789abcdef0123456789abcdef",
            "Python-Runtime-Environment-Digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "Python-Runtime-Environment-Image-Digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "Python-Runtime-Environment-Binding": "hie-record@1",
            "Python-Runtime-Environment-Profile": "hie-batch@1"
          },
          "body": {
            "replies": [
              {
                "resources": []
              },
              {
                "resources": []
              }
            ]
          }
        }
      ]
    }
  },
  "steps": [
    {
      "name": "start a slow run",
      "request": {
        "method": "POST",
        "path": "/api/transforms/try",
        "body": {
          "run_id": "c-1",
          "code": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        raise DataError(f\"value {value!r} is not a number\")\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"rt\"}],\n    }\n",
          "input": {
            "records": [
              {
                "id": 1,
                "value": "5.4"
              },
              {
                "id": 2,
                "value": "alto"
              }
            ]
          }
        }
      },
      "background": "slow"
    },
    {
      "sleep_ms": 500
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/transforms/try-runs/c-1/cancel"
      },
      "expect": {
        "status": 202,
        "body": {
          "run": "c-1",
          "cancelling": true
        }
      }
    },
    {
      "await": "slow",
      "expect": {
        "status": 200,
        "body": {
          "run": {
            "id": "c-1",
            "outcome": "stopped",
            "reason": "cancelled",
            "termination": "{{string}}"
          },
          "items": [
            {
              "disposition": "{{string}}",
              "result": "{{absent}}"
            },
            {
              "result": "{{absent}}"
            }
          ],
          "coverage": {
            "complete": false
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/transforms/try-runs/c-1/cancel"
      },
      "expect": {
        "status": 409,
        "body": {
          "error": "{{string}}",
          "code": "run_finished"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/transforms/try-runs/nope/cancel"
      },
      "expect": {
        "status": 404,
        "body": {
          "error": "{{string}}",
          "code": "run_not_found"
        }
      }
    }
  ]
}
