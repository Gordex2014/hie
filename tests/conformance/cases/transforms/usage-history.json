{
  "id": "transforms/usage-history",
  "title": "Usage per version: pin periods, ended ones included, and the loads each version ran",
  "fixtures": {
    "files": {
      "inbox/a.csv": "id,value\n1,5.4\n"
    }
  },
  "steps": [
    {
      "name": "create Lab results",
      "request": {
        "method": "POST",
        "path": "/api/transforms",
        "headers": {
          "Idempotency-Key": "c1"
        },
        "body": {
          "display_name": "Lab results",
          "code": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        raise DataError(f\"value {value!r} is not a number\")\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"v1\"}],\n    }\n",
          "note": "First version",
          "author": "Sam Whitaker"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "{{$tid}}",
          "current_version": 1
        }
      }
    },
    {
      "name": "save version 2",
      "request": {
        "method": "POST",
        "path": "/api/transforms/{{$tid}}/versions",
        "headers": {
          "Idempotency-Key": "v-a"
        },
        "body": {
          "code": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        raise DataError(f\"value {value!r} is not a number\")\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"v2\"}],\n    }\n",
          "base_version": 1
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "version": 2,
          "base_version": 1
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/sources",
        "body": {
          "id": "lab",
          "name": "Lab lab",
          "source": {
            "type": "folder",
            "path": "inbox",
            "pattern": "*.csv",
            "poll_seconds": 3600,
            "min_file_age_ms": 0
          },
          "transform": {
            "id": "{{$tid}}",
            "version": 1
          }
        }
      },
      "expect": {
        "status": 201
      }
    },
    {
      "name": "check lab now",
      "request": {
        "method": "POST",
        "path": "/api/sources/lab/check-now"
      },
      "expect": {
        "status": 202
      }
    },
    {
      "name": "wait for the load",
      "request": {
        "method": "GET",
        "path": "/api/sources/lab/loads"
      },
      "expect": {
        "status": 200,
        "body": {
          "loads": [
            "{{contains}}",
            {
              "name": "a.csv",
              "status": "done",
              "transform": {
                "version": 1
              }
            }
          ]
        }
      },
      "until_ms": 15000
    },
    {
      "request": {
        "method": "PUT",
        "path": "/api/sources/lab/pin",
        "body": {
          "version": 2
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "write_files": {
        "inbox/b.csv": "id,value\n2,6.1\n"
      }
    },
    {
      "name": "check lab now",
      "request": {
        "method": "POST",
        "path": "/api/sources/lab/check-now"
      },
      "expect": {
        "status": 202
      }
    },
    {
      "name": "wait for the load",
      "request": {
        "method": "GET",
        "path": "/api/sources/lab/loads"
      },
      "expect": {
        "status": 200,
        "body": {
          "loads": [
            "{{contains}}",
            {
              "name": "b.csv",
              "status": "done",
              "transform": {
                "version": 2
              }
            }
          ]
        }
      },
      "until_ms": 15000
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/transforms/{{$tid}}/usage"
      },
      "expect": {
        "status": 200,
        "body": {
          "transform": "{{$tid}}",
          "versions": [
            "{{contains}}",
            {
              "version": 1,
              "pins": [
                {
                  "source": "lab",
                  "mode": "pinned",
                  "since": "{{time}}",
                  "until": "{{time}}"
                }
              ],
              "runs": [
                {
                  "kind": "load",
                  "source": "lab",
                  "rows": 1,
                  "written": 1,
                  "failed": 0,
                  "outcome": "written"
                }
              ]
            },
            {
              "version": 2,
              "pins": [
                {
                  "source": "lab",
                  "until": null
                }
              ],
              "runs": [
                {
                  "kind": "load",
                  "outcome": "written"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "DELETE",
        "path": "/api/sources/lab"
      },
      "expect": {
        "status": 204
      }
    },
    {
      "name": "a deleted source's use stays in the history",
      "request": {
        "method": "GET",
        "path": "/api/transforms/{{$tid}}/usage"
      },
      "expect": {
        "status": 200,
        "body": {
          "versions": [
            "{{contains}}",
            {
              "version": 2,
              "pins": [
                {
                  "source": "lab",
                  "until": "{{time}}"
                }
              ],
              "runs": [
                {
                  "kind": "load"
                }
              ]
            }
          ]
        }
      }
    }
  ]
}
