{
  "id": "transforms/try-diagnostics-pass-through",
  "title": "The executor's per-item diagnostics come back unchanged, stdout and stderr included, in Try only",
  "covers": [],
  "fixtures": {
    "hie": {
      "runtime": {
        "url": "{{runtime}}",
        "token_env": "HIE_CONFORMANCE_NO_TOKEN"
      }
    },
    "runtime": {
      "try": [
        {
          "status": 200,
          "headers": {
            "Python-Runtime-Environment-Id": "cpython-3.14@2-env-0123456789abcdef0123456789abcdef",
            "Python-Runtime-Environment-Digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "Python-Runtime-Environment-Image-Digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "Python-Runtime-Environment-Binding": "hie-record@1",
            "Python-Runtime-Environment-Profile": "hie-batch@1"
          },
          "body": {
            "replies": [
              {
                "resources": [
                  {
                    "resourceType": "Observation",
                    "status": "final"
                  }
                ],
                "diagnostics": {
                  "warnings": [
                    {
                      "message": "unit missing, assumed mg/dL",
                      "path": "unit"
                    }
                  ],
                  "events": [
                    {
                      "kind": "explain",
                      "data": {
                        "step": "unit",
                        "from": null,
                        "to": "mg/dL"
                      }
                    }
                  ],
                  "stdout": "looking at row 1\n",
                  "stderr": "",
                  "truncated": false
                }
              },
              {
                "error": {
                  "kind": "data",
                  "message": "value 'alto' is not a number"
                },
                "diagnostics": {
                  "location": {
                    "line": 9,
                    "column": 9
                  },
                  "stderr": "Traceback (most recent call last): ...\n",
                  "truncated": true
                }
              }
            ]
          }
        }
      ]
    }
  },
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/api/transforms/try",
        "body": {
          "run_id": "d-1",
          "code": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        raise DataError(f\"value {value!r} is not a number\")\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"rt\"}],\n    }\n",
          "input": {
            "records": [
              {
                "id": 1,
                "value": "5.4"
              },
              {
                "id": 2,
                "value": "alto"
              }
            ]
          },
          "validate": false
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "run": {
            "outcome": "completed",
            "termination": "confirmed",
            "cleanup": "confirmed",
            "validation": "skipped",
            "environment": {
              "executor": "python-runtime",
              "id": "cpython-3.14@2-env-0123456789abcdef0123456789abcdef",
              "digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            }
          },
          "items": [
            {
              "disposition": "reported",
              "diagnostics": {
                "{{exact}}": true,
                "warnings": [
                  {
                    "message": "unit missing, assumed mg/dL",
                    "path": "unit"
                  }
                ],
                "events": [
                  {
                    "kind": "explain",
                    "data": {
                      "step": "unit",
                      "from": null,
                      "to": "mg/dL"
                    }
                  }
                ],
                "stdout": "looking at row 1\n",
                "stderr": "",
                "truncated": false
              },
              "validation": null
            },
            {
              "disposition": "reported",
              "result": {
                "error": {
                  "kind": "data"
                }
              },
              "diagnostics": {
                "{{exact}}": true,
                "location": {
                  "line": 9,
                  "column": 9
                },
                "stderr": "Traceback (most recent call last): ...\n",
                "truncated": true
              }
            }
          ]
        }
      }
    },
    {
      "runtime": {
        "calls": {
          "try": 1
        }
      }
    }
  ]
}
