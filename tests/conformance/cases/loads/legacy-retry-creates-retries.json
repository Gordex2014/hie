{
  "id": "loads/legacy-retry-creates-retries",
  "title": "The 0.1 retry creates one retry per failure group, skips a group already being retried, and links each to its group's chain",
  "fixtures": {
    "files": {
      "transforms/lab_csv.py": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        raise DataError(f\"value {value!r} is not a number\")\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"v1\"}],\n    }\n",
      "sources/lab.yaml": "id: lab\nname: Lab lab\nsource:\n  type: folder\n  path: inbox\n  pattern: \"*.csv\"\n  poll_seconds: 3600\n  min_file_age_ms: 0\ntransform: transforms/lab_csv.py\ndelivery:\n  initial_backoff_ms: 300\n  max_backoff_ms: 600\n",
      "inbox/a.csv": "id,value\n1,alto\n2,5.4\n3,xyz\n"
    }
  },
  "steps": [
    {
      "name": "check lab now",
      "request": {
        "method": "POST",
        "path": "/api/sources/lab/check-now"
      },
      "expect": {
        "status": 202
      }
    },
    {
      "name": "wait for the load",
      "request": {
        "method": "GET",
        "path": "/api/sources/lab/loads"
      },
      "expect": {
        "status": 200,
        "body": {
          "loads": [
            "{{contains}}",
            {
              "id": "{{$load}}",
              "status": "done",
              "rows": {
                "failed": 2
              }
            }
          ]
        }
      },
      "until_ms": 15000
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "failures": [
            "{{contains}}",
            {
              "group": "{{$ga}}",
              "reason": "value 'alto' is not a number"
            },
            {
              "group": "{{$gx}}",
              "reason": "value 'xyz' is not a number"
            }
          ]
        }
      }
    },
    {
      "name": "a first retry of one group, before any fix",
      "request": {
        "method": "POST",
        "path": "/api/loads/{{$load}}/retries",
        "headers": {
          "Idempotency-Key": "a1"
        },
        "body": {
          "group": "{{$ga}}",
          "version": null
        }
      },
      "expect": {
        "status": 202,
        "body": {
          "retry": {
            "id": "{{$a1}}",
            "previous": null,
            "transform": {
              "version": 1
            }
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}/retries/{{$a1}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "retry": {
            "status": "done",
            "failed": 1
          }
        }
      },
      "until_ms": 15000
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/transforms/lab_csv/versions",
        "headers": {
          "Idempotency-Key": "fix"
        },
        "body": {
          "code": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        number = 0.0\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"fixed\"}],\n    }\n",
          "base_version": 1
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "version": 2
        }
      }
    },
    {
      "name": "hold the destination's writes",
      "set_destination": {
        "writes": "hold"
      }
    },
    {
      "name": "the other group's retry stays active",
      "request": {
        "method": "POST",
        "path": "/api/loads/{{$load}}/retries",
        "headers": {
          "Idempotency-Key": "x1"
        },
        "body": {
          "group": "{{$gx}}",
          "version": null
        }
      },
      "expect": {
        "status": 202,
        "body": {
          "retry": {
            "id": "{{$x1}}",
            "previous": null,
            "transform": {
              "version": 2
            }
          }
        }
      }
    },
    {
      "name": "the 0.1 retry skips the active group",
      "request": {
        "method": "POST",
        "path": "/api/loads/{{$load}}/retry"
      },
      "expect": {
        "status": 202,
        "body": {
          "load": "{{$load}}",
          "retried": 1,
          "retries": [
            "{{$a2}}"
          ]
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}/retries/{{$a2}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "retry": {
            "group": "{{$ga}}",
            "previous": "{{$a1}}",
            "transform": {
              "id": "lab_csv",
              "version": 2
            },
            "rows": 1
          }
        }
      }
    },
    {
      "name": "release the writes",
      "set_destination": {
        "writes": "ok"
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}/retries/{{$a2}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "retry": {
            "status": "done",
            "written": 1
          }
        }
      },
      "until_ms": 15000
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}/retries/{{$x1}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "retry": {
            "status": "done",
            "written": 1
          }
        }
      },
      "until_ms": 15000
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}/retries"
      },
      "expect": {
        "status": 200,
        "body": {
          "retries": [
            "{{contains}}",
            {
              "id": "{{$a1}}",
              "group": "{{$ga}}"
            },
            {
              "id": "{{$x1}}",
              "group": "{{$gx}}"
            },
            {
              "id": "{{$a2}}",
              "group": "{{$ga}}"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "rows": {
            "failed": 0,
            "failed_ever": 2
          },
          "failures": [
            "{{contains}}",
            {
              "group": "{{$ga}}",
              "outstanding": 0,
              "resolved": 1,
              "resolved_at": "{{time}}",
              "retries": [
                "{{$a1}}",
                "{{$a2}}"
              ]
            },
            {
              "group": "{{$gx}}",
              "outstanding": 0,
              "resolved": 1,
              "resolved_at": "{{time}}",
              "retries": [
                "{{$x1}}"
              ]
            }
          ]
        }
      },
      "name": "both groups resolved, still listed"
    }
  ]
}
