{
  "id": "loads/outcome-unknown",
  "title": "Rows sent without a confirming answer read outcome unknown until a later attempt settles them",
  "fixtures": {
    "destination": {
      "writes": "unavailable"
    },
    "files": {
      "transforms/lab_csv.py": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        raise DataError(f\"value {value!r} is not a number\")\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"v1\"}],\n    }\n",
      "sources/lab.yaml": "id: lab\nname: Lab lab\nsource:\n  type: folder\n  path: inbox\n  pattern: \"*.csv\"\n  poll_seconds: 3600\n  min_file_age_ms: 0\ntransform: transforms/lab_csv.py\ndelivery:\n  initial_backoff_ms: 300\n  max_backoff_ms: 600\n",
      "inbox/a.csv": "id,value\n1,5.4\n2,6.1\n"
    }
  },
  "steps": [
    {
      "name": "check lab now",
      "request": {
        "method": "POST",
        "path": "/api/sources/lab/check-now"
      },
      "expect": {
        "status": 202
      }
    },
    {
      "name": "writes unconfirmed",
      "request": {
        "method": "GET",
        "path": "/api/sources/lab/loads"
      },
      "expect": {
        "status": 200,
        "body": {
          "loads": [
            "{{contains}}",
            {
              "name": "a.csv",
              "rows": {
                "outcome_unknown": 2,
                "written": 0,
                "failed": 0
              }
            }
          ]
        }
      },
      "until_ms": 15000
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/records?source=lab"
      },
      "expect": {
        "status": 200,
        "body": {
          "records": [
            "{{each}}",
            {
              "outcome": "outcome_unknown"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/sources/lab/stats?days=1"
      },
      "expect": {
        "status": 200,
        "body": {
          "today": {
            "outcome_unknown": 2,
            "written": 0
          }
        }
      }
    },
    {
      "set_destination": {
        "writes": "ok"
      }
    },
    {
      "name": "settled",
      "request": {
        "method": "GET",
        "path": "/api/sources/lab/loads"
      },
      "expect": {
        "status": 200,
        "body": {
          "loads": [
            "{{contains}}",
            {
              "name": "a.csv",
              "status": "done",
              "rows": {
                "outcome_unknown": 0,
                "written": 2
              }
            }
          ]
        }
      },
      "until_ms": 15000
    }
  ]
}
