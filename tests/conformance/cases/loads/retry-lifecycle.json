{
  "id": "loads/retry-lifecycle",
  "title": "A durable retry: key required and replayed, one at a time per group, followed to its end, then nothing left to retry",
  "fixtures": {
    "files": {
      "transforms/lab_csv.py": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        raise DataError(f\"value {value!r} is not a number\")\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"v1\"}],\n    }\n",
      "sources/lab.yaml": "id: lab\nname: Lab lab\nsource:\n  type: folder\n  path: inbox\n  pattern: \"*.csv\"\n  poll_seconds: 3600\n  min_file_age_ms: 0\ntransform: transforms/lab_csv.py\ndelivery:\n  initial_backoff_ms: 300\n  max_backoff_ms: 600\n",
      "inbox/a.csv": "id,value\n1,alto\n2,5.4\n3,alto\n"
    }
  },
  "steps": [
    {
      "name": "check lab now",
      "request": {
        "method": "POST",
        "path": "/api/sources/lab/check-now"
      },
      "expect": {
        "status": 202
      }
    },
    {
      "name": "wait for the load",
      "request": {
        "method": "GET",
        "path": "/api/sources/lab/loads"
      },
      "expect": {
        "status": 200,
        "body": {
          "loads": [
            "{{contains}}",
            {
              "id": "{{$load}}",
              "status": "done",
              "rows": {
                "failed": 2
              }
            }
          ]
        }
      },
      "until_ms": 15000
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "failures": [
            {
              "group": "{{$g}}",
              "count": 2,
              "outstanding": 2,
              "resolved": 0,
              "first_failed_at": "{{$first_failed_at}}",
              "resolved_at": null,
              "retries": []
            }
          ]
        }
      }
    },
    {
      "name": "save a fix",
      "request": {
        "method": "POST",
        "path": "/api/transforms/lab_csv/versions",
        "headers": {
          "Idempotency-Key": "fix"
        },
        "body": {
          "code": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        number = 0.0\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"fixed\"}],\n    }\n",
          "base_version": 1
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "version": 2
        }
      }
    },
    {
      "name": "hold the destination's writes",
      "set_destination": {
        "writes": "hold"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/loads/{{$load}}/retries",
        "body": {
          "group": "{{$g}}",
          "version": null
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "error": "{{string}}",
          "code": "idempotency_key_required"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/loads/{{$load}}/retries",
        "headers": {
          "Idempotency-Key": "r0"
        },
        "body": {
          "group": "{{$g}}",
          "version": 9
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "error": "{{string}}",
          "code": "version_not_found"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/loads/{{$load}}/retries",
        "headers": {
          "Idempotency-Key": "r1"
        },
        "body": {
          "group": "{{$g}}",
          "version": null
        }
      },
      "expect": {
        "status": 202,
        "body": {
          "retry": {
            "id": "{{$rt}}",
            "load": "{{$load}}",
            "group": "{{$g}}",
            "transform": {
              "id": "lab_csv",
              "version": 2
            },
            "status": "{{string}}",
            "rows": 2,
            "previous": null,
            "accepted_at": "{{time}}"
          }
        }
      }
    },
    {
      "name": "the same key is the same retry",
      "request": {
        "method": "POST",
        "path": "/api/loads/{{$load}}/retries",
        "headers": {
          "Idempotency-Key": "r1"
        },
        "body": {
          "group": "{{$g}}",
          "version": null
        }
      },
      "expect": {
        "status": 202,
        "body": {
          "retry": {
            "id": "{{$rt}}"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/loads/{{$load}}/retries",
        "headers": {
          "Idempotency-Key": "r2"
        },
        "body": {
          "group": "{{$g}}",
          "version": null
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "error": "{{string}}",
          "code": "retry_in_progress",
          "retry": "{{any}}"
        }
      }
    },
    {
      "name": "a version saved while the retry runs",
      "request": {
        "method": "POST",
        "path": "/api/transforms/lab_csv/versions",
        "headers": {
          "Idempotency-Key": "later"
        },
        "body": {
          "code": "import time\nfrom hie import DataError\n\n\ndef transform(record, context):\n    pass\n    value = str(record[\"value\"])\n    try:\n        number = float(value)\n    except ValueError:\n        number = 0.0\n    return {\n        \"resourceType\": \"Observation\",\n        \"id\": f\"obs-{record['id']}\",\n        \"status\": record.get(\"status\") or \"final\",\n        \"code\": {\"text\": \"glucose\"},\n        \"valueQuantity\": {\"value\": number},\n        \"note\": [{\"text\": \"later\"}],\n    }\n",
          "base_version": 2
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "version": 3
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}/retries/latest"
      },
      "expect": {
        "status": 200,
        "body": {
          "retry": {
            "id": "{{$rt}}"
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}/retries"
      },
      "expect": {
        "status": 200,
        "body": {
          "retries": [
            {
              "id": "{{$rt}}"
            }
          ]
        }
      }
    },
    {
      "name": "rows in flight: the group stays listed, not resolved yet",
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "failures": [
            {
              "group": "{{$g}}",
              "count": 0,
              "outstanding": 0,
              "resolved": 0,
              "resolved_at": null,
              "retries": [
                "{{$rt}}"
              ]
            }
          ]
        }
      }
    },
    {
      "name": "release the writes",
      "set_destination": {
        "writes": "ok"
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}/retries/{{$rt}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "retry": {
            "status": "done",
            "written": 2,
            "failed": 0,
            "finished_at": "{{time}}",
            "transform": {
              "version": 2
            }
          }
        }
      },
      "until_ms": 15000
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "rejected": 0,
          "rows": {
            "failed": 0,
            "failed_ever": 2,
            "written": 3
          },
          "failures": [
            {
              "group": "{{$g}}",
              "count": 0,
              "outstanding": 0,
              "resolved": 2,
              "first_failed_at": "{{$first_failed_at}}",
              "resolved_at": "{{time}}",
              "retries": [
                "{{$rt}}"
              ],
              "content": "purged",
              "samples": []
            }
          ]
        }
      },
      "name": "the resolved group stays listed with its history"
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}/failures/{{$g}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "group": "{{$g}}",
          "count": 0,
          "outstanding": 0,
          "resolved": 2,
          "resolved_at": "{{time}}",
          "retries": [
            "{{$rt}}"
          ],
          "records": []
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/loads/{{$load}}/retries",
        "headers": {
          "Idempotency-Key": "r3"
        },
        "body": {
          "group": "{{$g}}",
          "version": null
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "error": "{{string}}",
          "code": "nothing_to_retry"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/loads/{{$load}}/retries/rt_nope"
      },
      "expect": {
        "status": 404,
        "body": {
          "error": "{{string}}",
          "code": "retry_not_found"
        }
      }
    },
    {
      "destination": {
        "stored": [
          {
            "id": "obs-1",
            "note": [
              {
                "text": "fixed"
              }
            ]
          },
          {
            "id": "obs-3",
            "note": [
              {
                "text": "fixed"
              }
            ]
          }
        ],
        "not_stored": [
          {
            "note": [
              {
                "text": "later"
              }
            ]
          }
        ]
      }
    }
  ]
}
